const {  TABLE_MAX  } = require("/src/domain/contracts.js");const {  confidenceOf  } = require("/src/domain/mastery.js");const {  canonicalKey  } = require("/src/domain/math.js");const {  escapeHtml, formatFact  } = require("/src/ui/view.js");const STATUS_LABELS = Object.freeze({ new: 'novo', practice: 'em treino', revisit: 'reforçar', steady: 'firme por enquanto' })

function progressCell(progress, a, b) {
  const item = progress[canonicalKey(a, b)]
  const status = item?.status || 'new'
  const confidence = confidenceOf(item)
  return `<td class="fact-cell fact-${status}" title="${formatFact(canonicalKey(a, b))}: ${STATUS_LABELS[status]}"><span>${item ? confidence : '·'}</span></td>`
}

function factTable(progress) {
  const headers = Array.from({ length: TABLE_MAX + 1 }, (_, index) => `<th scope="col">${index}</th>`).join('')
  const rows = Array.from({ length: TABLE_MAX + 1 }, (_, a) => `<tr><th scope="row">${a}</th>${Array.from({ length: TABLE_MAX + 1 }, (_, b) => progressCell(progress, a, b)).join('')}</tr>`).join('')
  return `<div class="table-scroll"><table class="fact-table"><caption>Confiança observada por fato. Quanto mais alto, mais acertos independentes foram registrados.</caption><thead><tr><th scope="col">×</th>${headers}</tr></thead><tbody>${rows}</tbody></table></div>`
}

function safeFocus(selector) {
  globalThis.setTimeout?.(() => document.querySelector(selector)?.focus(), 0)
}

function formatDuration(milliseconds) {
  if (!Number.isFinite(milliseconds)) return '—'
  return `${(milliseconds / 1000).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} s`
}



exports.STATUS_LABELS = STATUS_LABELS;
exports.progressCell = progressCell;
exports.factTable = factTable;
exports.safeFocus = safeFocus;
exports.formatDuration = formatDuration;
exports.escapeHtml = escapeHtml;
exports.formatFact = formatFact;
