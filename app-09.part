  const repeatButton = sequential ? `<button class="button button-primary button-large" data-start="sequential" data-table="${report.table}">Repetir tabuada do ${report.table}</button>` : '<button class="button button-primary button-large" data-start="reinforce">Fazer reforço do Pingo</button>'
