  return `<button class="table-choice ${table === active ? 'is-suggested' : ''} ${readiness.ready ? 'is-ready' : ''}" data-start="sequential" data-table="${table}" aria-label="Treinar tabuada do ${table}, ${state}"><strong>${table}</strong><span>${state}</span></button>`
}

