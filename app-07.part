}

function saveState(state, storage = globalThis.localStorage) {
  if (!storage) return
  storage.setItem(STORAGE_KEY, JSON.stringify({ ...state, route: 'home', attempts: state.attempts.slice(-1000) }))
}

function clearState(storage = globalThis.localStorage) {
  storage?.removeItem(STORAGE_KEY)
}

