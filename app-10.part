s = report.focusFacts?.length ? report.focusFacts.map((item) => `<li><strong>${formatFact(item.key)}</strong><span>${item.wrong} erro(s) em ${item.attempts} tentativa(s)</span></li>`).join('') : '<li><strong>Nenhum ponto de atenção recorrente.</strong><span>Continue misturando fatos.</span></li>'
  const page = view(`<main class="page results-page"><section class="result-hero panel"><div><span class="eyebrow">Rota concluída</span><h1>${title}</h1><p>${intro}</p></div><div class="result-score"><strong>${report.solved}</strong><span>de ${report.questions} placas acesas</span></div></section><section class="result-grid"><article class="panel result-card"><span class="eyebrow">Evidência da sessão</span><h2>${report.independent} tentativa(s) independente(s)</h2><p>${report.assisted ? `${report.assisted} acerto(s) aconteceram com pista — isso também é aprendizagem, só fica separado.` : 'Os acertos aconteceram sem pista nesta sessão.'}</p><p class="microcopy">Foram registradas ${report.attempts} tentativa(s), contando repetições.</p></article><article class="panel result-card"><span class="eyebrow">Pingo recomenda</span><h2>${escapeHtml(report.bot.message)}</h2><p>${escapeHtml(report.bot.recommendation)}</p></article></section><section class="panel focus-card"><span class="eyebrow">Próxima manutenção</span><h2>Fatos que merecem reencontro</h2><ul class="focus-list">${facts}</ul></section><section class="next-actions">${repeatButton}${followUpButton}<button class="text-button" data-home>Voltar ao início</button></section></main>`)
  page.querySelectorAll('[data-start]').forEach((button) => button.addEventListener('click', () => store.startSession(button.dataset.start, button.dataset.table ? { table: Number(button.dataset.table) } : {})))
  page.querySelector('[data-home]')?.addEventListener('click', () => store.navigate('home'))
  return page
}

exports.resultsScreen = resultsScreen;
