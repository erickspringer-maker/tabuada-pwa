  const guessRows = bot.timing.fastGuess.length ? bot.timing.fastGuess.slice(0, 5).map((item) => `<li><strong>${formatFact(item.key)}</strong><span>respostas rápidas e incorretas repetidas</span></li>`).join('') : '<li><strong>Nenhum padrão de chute sugerido.</strong><span>O tempo nunca é lido sozinho.</span></li>'
  const page = view(`<main class="page adult-page"><div class="section-heading"><div><span class="eyebrow">Painel local</span><h1>Leitura do percurso</h1></div><span class="local-badge">dados no dispositivo</span></div><section class="adult-grid"><article class="panel"><span class="eyebrow">Sugestão do Pingo</span><h2>${escapeHtml(bot.message)}</h2><p>${escapeHtml(bot.recommendation)}</p><p class="microcopy">Isto é uma leitura de tentativas, não um diagnóstico clínico.</p></article><article class="panel"><span class="eyebrow">Atividade</span><div class="adult-metrics"><strong>${state.attempts.length}<small>tentativas</small></strong><strong>${state.sessionsCompleted}<small>sessões</