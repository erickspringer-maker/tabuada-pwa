  [ERROR_CODES.UNKNOWN]: 'Continue alternando conta, grupos e grade até aparecer um padrão mais claro.'
})

function summarizeErrors(attempts) {
  const counts = {}
  for (const attempt of attempts) {
    if (attempt.errorCode) counts[attempt.errorCode] = (counts[attempt.errorCode] || 0) + 1
  }
  return Object.entries(counts)
    .sort((left, right) => right[1] - left[1])
    .map(([code, count]) => ({ code, count, label: ERROR_LABELS[code] || 'padrão não identificado' }))
}

