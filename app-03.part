 = 0
const TABLE_MAX = 10

const TABLE_ORDER = Object.freeze([0, 1, 2, 5, 10, 3, 4, 6, 7, 8, 9])

const ERROR_CODES = Object.freeze({
  SUM_INSTEAD_PRODUCT: 'SUM_INSTEAD_PRODUCT',
  NEIGHBOR_FACT: 'NEIGHBOR_FACT',
  OFF_BY_ONE_GROUP: 'OFF_BY_ONE_GROUP',
  ZERO_ONE_CONFUSION: 'ZERO_ONE_CONFUSION',
  COUNTING_DRIFT: 'COUNTING_DRIFT',
  GUESS_PATTERN: 'GUESS_PATTERN',
  UNKNOWN: 'UNKNOWN'
})

const MODES = Object.freeze({
  sequential: Object.freeze({ label: 'Trilha sequencial', length: 33, cycles: 3 }),
  guided: Object.freeze({ label: 'Treino guiado', length: 12 }),
  reinforce: Object.freeze({ label: 'Reforço do Pingo', length: 18 }),
  marathon: Object.freeze({ label: 'Maratona', length: 30 }),
  complete: Object.freeze({ label: 'Varredura completa', length: 66 })
})

const FACT_STATUS = Object.freeze({
  NEW: 'new',
  PRACTICE: 'practice',
  REVISIT: 'revisit',
  STEADY: 'steady'
})

exports.APP_VERSION = APP_VERSION;
exports.SCHEMA_VERSION = SCHEMA_VERSION;
exports.TABLE_MIN = TABLE_MIN;
